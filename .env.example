# Enterprise HR Agentic Solution - Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT commit real secrets or credentials to source control.

APP_ENV=production
LOG_LEVEL=INFO
DEFAULT_USER_ID=EMP-90210
AUTOMATION_ORIGIN=AI_HR_AGENT_MVP1

# Model Context Protocol (MCP) Bearer Token
# In production, populate securely from Google Cloud Secret Manager:
#   gcloud secrets versions access latest --secret="mcp-token"
MCP_TOKEN=mcp_WW-RBifouI0mJwWeUcfMa7mbF6SMxqdR4iU_Ey1BKOo
USE_MCP_CONNECTORS=true
MCP_SERVER_URL=http://localhost:8080/api/v1/mcp/rpc

# Mock SaaS Integration URL (Aish Prabhat Elevate Module 3)
MOCK_SAAS_URL=https://mock-saas.aishprabhat.demo.altostrat.com

# Google Cloud & Vertex AI Gemini Configuration
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=genial-union-475913-i7
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash

# Google Cloud Firestore Native Persistence
FIRESTORE_PROJECT_ID=genial-union-475913-i7
FIRESTORE_DATABASE=(default)
